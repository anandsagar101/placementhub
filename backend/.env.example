# ---------- Required ----------
# MongoDB Atlas connection string. Include the DB name in the path OR set DB_NAME separately.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=placement-portal

# Long random string used to sign JWT tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-string

# Comma-separated list of ORIGINS that are allowed to call this API (your frontend URL(s))
# For local dev include http://localhost:3000
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ---------- Optional but recommended ----------
# Google Gemini (needed for AI review / recommendations)
GEMINI_API_KEY=

# Cloudinary (needed for document uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed a default Super Admin at startup
ADMIN_EMAIL=admin@placementhub.com
ADMIN_PASSWORD=Admin@12345
